# Never commit a real key. Inject it only in the shell that runs a live test.
# The experiment runner reads the variable named by QWEN_API_KEY_ENV.
QWEN_API_KEY_ENV=ANTHROPIC_AUTH_TOKEN
QWEN_MODEL=qwen3.8-flash

# OpenAI-compatible base URL (SDK clients append /responses).
QWEN_BASE_URL=https://ws-smqn3wel83c2p9wd.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Raw HTTP endpoint used by this repository's runner.
QWEN_RESPONSES_URL=https://ws-smqn3wel83c2p9wd.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1/responses

# Optional compatibility names for an existing Anthropic-oriented shell setup.
# They are not used by the standalone OpenAI Responses runner.
ANTHROPIC_BASE_URL=https://ws-smqn3wel83c2p9wd.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_DEFAULT_SONNET_MODEL=qwen3.8-flash

